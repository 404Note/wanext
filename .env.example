# wanext 本地配置模板：复制为 .env 后填入真实值。
# .env 未追踪，绝不提交；进程环境变量优先于 .env。
# 后端启动时自动加载同目录下的 .env（仅补齐进程环境变量中未设置的键）。

# 对外绝对地址前缀（小程序与媒体直链用），如 https://api.example.com；
# 子路径部署时必须带上前缀，如 https://example.com/wx-mp/wanext；未配置时保持相对路径
BASE_URL=

# 上游出口代理（可选）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# 微信登录鉴权（wx-mp 上线用；AUTH_REQUIRED=1 时必填）
# 登录接口路径为 POST /api/login
WX_APPID=
WX_SECRET=

# 强制微信登录鉴权：1=开启（缺密钥启动失败），0=关闭（缺省，本地开发与 Web 页调试）
AUTH_REQUIRED=0

# JWT 签名密钥（≥32 字节随机值，鉴权开启时必填；与 WX_SECRET 分开）
JWT_SECRET=

# 紧急兜底封禁名单（uid 逗号分隔；管理页不可用时才用，平时走管理页在线封禁）
BANNED_UIDS=

# 管理页（单人运维用）：1=启用，需同时配置 ADMIN_USER 与 ADMIN_PASSWORD（密码≥6 位）
ADMIN_ENABLED=0
ADMIN_USER=
ADMIN_PASSWORD=

# 服务挂载的子路径前缀（nginx 反代到 location 前缀下时用，如 /wx-mp/wanext；缺省根路径）
# 注意：nginx 的 proxy_pass 末尾不要加 /，保持完整路径透传给后端
BASE_PATH=

# 管理页状态文件目录（封禁名单与操作记录落盘，缺省 data）
ADMIN_DATA_DIR=data
